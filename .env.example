# Copy to .env (gitignored) and fill in, then load with:  set -a; source .env; set +a
# None of these are secrets, but the workspace identifiers still come from your environment,
# never from code (CLAUDE.md: no hardcoded Azure names).

# MLflow tracking and registry live in the Azure ML workspace. Get the URI with:
#   az ml workspace show --name <workspace> --resource-group <resource-group> --query mlflow_tracking_uri -o tsv
MLFLOW_TRACKING_URI=

# Experiment that receives every training run
MLFLOW_EXPERIMENT_NAME=driftwatch-training

# Registry name that training.register promotes into and the serving image pulls from
DRIFTWATCH_MODEL_NAME=driftwatch-failure-classifier
